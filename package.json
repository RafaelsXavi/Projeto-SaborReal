{
  "name": "projeto-saborreal",
  "version": "1.0.5",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @saborreal/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format . --write",
    "test": "npm -w @saborreal/api test",
    "test:db": "npm -w @saborreal/api run test:db",
    "db:migrate": "npm -w @saborreal/api run db:migrate",
    "ci:biome": "biome ci . --error-on-warnings --max-diagnostics=none",
    "ci:check": "npm run ci:biome && npm run typecheck && npm test",
    "ci:web:build": "npm -w @saborreal/web run build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "docker:ps": "docker compose ps",
    "dev:web": "npm -w @saborreal/web run dev",
    "dev:all": "npm -ws --if-present --parallel run dev",
    "seed:catalog": "node node_modules/typescript/bin/tsc --target ES2022 --module commonjs --rootDir . --outDir .tmp/seed scripts/seed-real-menu.ts && node .tmp/seed/scripts/seed-real-menu.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "happy-dom": "^20.8.4",
    "jsdom": "^29.0.0",
    "vitest": "^4.1.0"
  }
}

# API
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
TRUST_PROXY=false

# Comma-separated list, ex: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:27017

# Auth (JWT)
# Em producao: gere um segredo longo e aleatorio (32+ bytes).
JWT_SECRET=change-me
JWT_ISSUER=saborreal-api
JWT_AUDIENCE=saborreal-web
ACCESS_TOKEN_TTL_SECONDS=900
ACCESS_TOKEN_COOKIE_NAME=sr_at
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=sr_rt
CSRF_COOKIE_NAME=sr_csrf
# Para Web/API em domínios diferentes (ex.: *.vercel.app), use:
# COOKIE_SAMESITE=none  (exige HTTPS + Secure)
# Para Web/API no mesmo domínio base (ex.: app.saborreal.com + api.saborreal.com), pode manter:
# COOKIE_SAMESITE=lax
COOKIE_SAMESITE=lax
# Opcional: define Domain do cookie (ex.: .saborreal.com). Nao use em localhost.
# COOKIE_DOMAIN=.saborreal.com
# Habilita /v1/auth/dev-login em dev/test (desabilitado em producao por padrao).
DEV_AUTH_ENABLED=true

# Postgres (PII + pedidos)
# Em Serverless (Vercel) com Supabase, use a connection string com pooler (porta 6543)
# DATABASE_URL=postgres://postgres.[project]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/saborreal

# Para provedores que exigem TLS no Postgres (Supabase, Neon, etc):
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true

# Mongo (eventos/jobs/audit - opcional no MVP)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=saborreal

/* Produção (Vercel)
NODE_ENV=production
TRUST_PROXY=true
JWT_SECRET=<segredo longo e aleatorio>
PG_SSL=true (se seu provedor exigir TLS)
DATABASE_URL=<connection string>
CORS_ORIGINS=https://<seu-web>.vercel.app
COOKIE_SAMESITE=none (se Web/API estiverem em domínios diferentes)
*/

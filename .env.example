# API
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
TRUST_PROXY=false

# Comma-separated list, ex: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=http://localhost:5173

# Auth (JWT)
# Em produção: gere um segredo longo e aleatório (32+ bytes).
JWT_SECRET=change-me
JWT_ISSUER=saborreal-api
JWT_AUDIENCE=saborreal-web
ACCESS_TOKEN_TTL_SECONDS=900
ACCESS_TOKEN_COOKIE_NAME=sr_at
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=sr_rt
CSRF_COOKIE_NAME=sr_csrf
# Habilita /v1/auth/dev-login em dev/test (desabilitado em produção por padrão).
DEV_AUTH_ENABLED=true

# Postgres (PII + pedidos)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/saborreal
# Para provedores que exigem TLS no Postgres (ex.: cloud):
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true

# Mongo (eventos/jobs/audit - opcional no MVP)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=saborreal
